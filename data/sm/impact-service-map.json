{
  "_comment": "Impact Service Map — maps Prometheus app_name labels to business service names. Update this when new services are deployed.",

  "prod_namespaces": [
    "truemoney.*",
    "truemoney-core-production",
    "truemoney-mobile-backend-production",
    "truemoney-alipay-gn-production",
    "truemoney-alipay-gka-production",
    "truemoney-common-production",
    "truemoney-dataplatform-production",
    "truemoney-ecatalog-production",
    "acm.*"
  ],

  "thresholds": {
    "restart_min":         1,
    "http_5xx_min":        1,
    "latency_spike_ratio": 3.0,
    "bank_error_min":      5
  },

  "bank_map": {
    "KBANK": "KBank (ATM/iBanking/Mobile Banking)",
    "SCB":   "SCB (ATM/iBanking/Mobile Banking)",
    "KTB":   "KTB Krungthai (ATM/iBanking/Mobile Banking)",
    "GSB":   "ออมสิน (ATM/iBanking)",
    "BBL":   "Bangkok Bank (BBL/BGW)",
    "BAY":   "Bank of Ayudhya (Krungsri)",
    "TTB":   "TMBThanachart (TTB)",
    "BAAC":  "ธ.ก.ส. (BAAC)",
    "LHB":   "LHBank",
    "UOB":   "UOB",
    "CIMB":  "CIMB",
    "KKP":   "Kiatnakin Phatra (KKP)"
  },

  "service_map": {
    "mobile-auth-service": {
      "category": "Authentication",
      "business_services": ["Login TrueMoney Wallet", "PIN Authentication", "Biometric Login"],
      "is_gateway": false,
      "severity_boost": true
    },
    "core-service": {
      "category": "Core Platform",
      "business_services": [
        "Login TMN", "ทุก Transaction (isActive check)",
        "Fund-in All BANK", "Direct Debit All BANK",
        "Cash Out", "Barcode", "Financial Home",
        "History", "Profile"
      ],
      "is_gateway": false,
      "severity_boost": true,
      "_note": "core-service /trans/isActive is called by ALL transaction flows"
    },
    "tmn-mobile-gateway": {
      "category": "Mobile App Gateway",
      "business_services": [
        "Login TMN", "Barcode", "Cash Out", "History",
        "Fund-in All BANK", "E-PIN From Wallet",
        "Topup Mobile ผ่าน TMN", "Game Topup Center",
        "Redeem Coin ABC", "CP Payment",
        "SafeGold", "Financial Home", "POI Topup Wallet",
        "Lotus's Online", "Lotus's HYPERMARKET"
      ],
      "is_gateway": true,
      "_note": "Main API gateway for TrueMoney App — any restart affects ALL app features"
    },
    "wallet-payment-service": {
      "category": "Payments",
      "business_services": [
        "Fund-in All BANK", "Topup Wallet Via Credit Card",
        "POI Topup Wallet", "CP Payment",
        "Lotus's Online", "Lotus's HYPERMARKET"
      ],
      "is_gateway": false,
      "_uris": {
        "/v3/loads":      "Fund-in / Wallet Top-up",
        "/v2/deducts":    "Payment Deduction (QR/Barcode/Online)",
        "/v1/cancelDeduct": "Cancel Payment",
        "/v1/refund":     "Refund"
      }
    },
    "acm-unified-alipay-gateway": {
      "category": "Merchant / Partner",
      "business_services": ["Lazada Payment", "TikTok Payment", "Alipay Connect (all merchants)"],
      "is_gateway": false
    },
    "acm-bbl-gateway": {
      "category": "Banking",
      "business_services": ["Fund-in via BGW (Bangkok Bank)", "Direct Debit BBL"],
      "is_gateway": false
    },
    "bank-service": {
      "category": "Banking",
      "business_services": [
        "Fund-in All BANK", "Direct Debit All BANK",
        "Binding All BANK", "Topup Wallet Via Credit Card"
