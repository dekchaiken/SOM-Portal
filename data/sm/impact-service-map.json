      "is_gateway": false
    },
    "asset-service": {
      "category": "SafeGold / Asset",
      "business_services": ["SafeGold", "Asset Management"],
      "is_gateway": false
    },
    "asset-binder": {
      "category": "SafeGold / Asset",
      "business_services": ["Binding Credit Card", "Binding All BANK"],
      "is_gateway": false
    },
    "acquiring-service": {
