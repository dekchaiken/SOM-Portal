{
  "_comment": "Per-runway Grafana/Prometheus config used by cron/restart-monitor-fetch.php and api/restart-monitor/upload.php. The slug (folder-safe) is used for filesystem paths under data/grafana-monitoring/{raw,daily}/{slug}/. tokenEnv references a key in .env so secrets never live in this repo file. cluster=\"\" means the runway's Prometheus doesn't filter by cluster label (single-cluster instance, e.g. OCP).",
  "runways": [
    {
      "name": "EKS TMN",
      "slug": "EKS-TMN",
      "grafanaUrl": "https://grafana-thanos.truemoney.com",
      "tokenEnv": "GRAFANA_SERVICE_ACCOUNT_TOKEN",
      "orgId": 2,
      "dsUid": "1PmuAFTGk",
      "cluster": "acm-tmn-eks-prod",
      "namespaceRegex": "truemoney.*",
      "namespaceExclude": "",
      "podExclude": "jenkins-slave-.*|logging-cluster-zookeeper-.*",
      "chatWebhookEnv": "RESTART_MONITOR_CHAT_WEBHOOK_EKS_TMN",
      "color": "#3b82f6"
    },
    {
      "name": "EKS NANO",
      "slug": "EKS-NANO",
      "grafanaUrl": "https://grafana-thanos.truemoney.com",
      "tokenEnv": "GRAFANA_SERVICE_ACCOUNT_TOKEN",
      "orgId": 2,
      "dsUid": "1PmuAFTGk",
      "cluster": "nano-eks-prod",
      "namespaceRegex": "nano.*",
      "namespaceExclude": ".*-logging-v2|.*-tracing-v2",
      "podExclude": "jenkins-slave-.*|job-controller-.*",
      "chatWebhookEnv": "RESTART_MONITOR_CHAT_WEBHOOK_EKS_NANO",
      "color": "#a855f7"
    },
    {
      "name": "OCP",
      "slug": "OCP",
      "grafanaUrl": "https://grafana.th1p.ascendmoney.io",
      "tokenEnv": "GRAFANA_TH1P_TOKEN",
      "orgId": 9,
      "dsUid": "000000050",
      "cluster": "",
      "namespaceRegex": "truemoney.*-production|nano.*-production",
      "namespaceExclude": "",
      "podExclude": "openshift-demo-.*|nano-eks-.*|jenkins-.*|job-controller-.*|acm-openshift-demo-.*",
      "chatWebhookEnv": "RESTART_MONITOR_CHAT_WEBHOOK_OCP",
      "color": "#14b8a6"
    }
  ]
}
