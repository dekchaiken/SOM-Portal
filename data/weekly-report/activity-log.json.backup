    {
        "id": "log_69815bf3d8ecc4.64704701",
        "timestamp": "2026-02-03T02:22:43+00:00",
        "email": "kritsada.cha@ascendcorp.com",
        "action": "UPDATE",
        "category": "updates",
        "details": {
            "week": "2026-01-27",
            "name": "Update เรื่อง Collection Lead File",
            "subType": "handover",
            "oldData": {
                "name": "Update เรื่อง Collection Lead File",
                "date": "2026-01-28",
                "desc": "สืบเนื่องจาก เดิมที่เราจะไปกับ Volare เต็มตัววันที่ 29 Jan และจะไม่ไปต่อกับ Terrabit ในเดือน Feb แต่จาก message ล่าสุดที่ได้รับ ปรากฎว่า Vendor มีงาน Develop บางอย่างที่ไม่เรียบร้อย ไม่สามารถ follow ตาม plan เดิมได้ได้  และ เคาะวันใหม่ที่ได้คือ 12. Feb (ก่อนหน้าต้องเสร็จพร้อมเทสภายในวันที่ 08 Feb). หลังจากนั้นจะ Parallel สองระบบ ต่อ ไปจน 1 March (Month End ในมุม Collection DueDate การชำระหนี้) และ 2 March (เริ่ม Cycle ใหม่) จะ เป็นวันที่ Shut Down กับ Terrabit ตาม Plan ด้านล่าง  ดังนั้น เราต้อง monitor สองระบบไปจนถึงสิ้น Feb",
                "ticketId": "Chat",
                "url": "https:\/\/chat.google.com\/room\/AAAAxBUGtac\/2lYWz4qh6Y4\/5rF2Jx-wxf8?cls=10",
                "status": "Inprogress"
            },
            "newData": {
                "name": "Update เรื่อง Collection Lead File",
                "date": "2026-01-31",
                "desc": "Updated เรื่อง Collection Lead Files ของ Terrabit จ้าาา ตั้งแต่ 1-8 Feb ถ้ามีปัญหาเกี่ยวกับ Lead Files ที่ส่งให้ Terrabit  ให้ SM ติดต่อเฌอกาญจน์ แต่เพียงผู้เดียวนะคะ ไม่ต้องติดต่อ Terrabit แล้ว ถ้าพังฉันจะทำให้ดีที่สุดเท่าที่ฉันทำได้ Note : ทางพี่ๆ Management เค้าจะ Force ให้ Migrate ไป Volare 9-Feb ค่ะ ",
                "ticketId": "Chat",
                "url": "https:\/\/chat.google.com\/room\/AAAAxBUGtac\/2lYWz4qh6Y4\/5rF2Jx-wxf8?cls=10",
                "status": "Inprogress"
            }
        },
        "ip": "192.168.187.24"
    },
