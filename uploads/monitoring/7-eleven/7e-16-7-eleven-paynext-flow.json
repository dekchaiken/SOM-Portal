        "content": "%%{init: {\"flowchart\": {\"useMaxWidth\": true, \"htmlLabels\": true}, \"theme\": \"dark\"}}%%\ngraph TD\n  ACQ[\"Acquiring Service\"] --> NG[\"Nano Gateway\"]\n\n  subgraph PN_G[\"PayNext\"]\n    pn_ok([\"OK\"])\n    pn_fail([\"Fail\"])\n  end\n\n  subgraph PNE_G[\"PayNext Extra\"]\n    pne_ok([\"OK\"])\n    pne_fail([\"Fail\"])\n  end\n\n  NG --> PN_G\n  NG --> PNE_G\n  classDef svc    fill:#242930,stroke:#5794c7,stroke-width:2px,color:#fff\n  classDef ok     fill:#1c2c22,stroke:#47a468,stroke-width:2px,color:#fff\n  classDef fail   fill:#2c1e1e,stroke:#cc3333,stroke-width:2px,color:#fff\n  classDef client fill:#2c2020,stroke:#e05252,stroke-width:3px,color:#e05252,font-weight:bold\n  classDef net    fill:#2c251e,stroke:#ff8c42,stroke-width:2px,color:#fff",
        "links": [],
        "style": "width:100%;",
        "useBackground": false,
        "valueName": "current"
      },
