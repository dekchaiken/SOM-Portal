        "content": "%%{init: {\"flowchart\": {\"useMaxWidth\": true, \"htmlLabels\": true}, \"theme\": \"dark\"}}%%\ngraph TD\n  GW711[\"seven-custom-in-gateway\"] --> ACQ[\"Acquiring Service\"]\n\n  ACQ -->|200| acq_ok([\"Total: OK\"])\n  ACQ -->|non-200| acq_fail([\"Total: Fail\"])\n\n  subgraph BREAKDOWN[\"Fail — breakdown by SoF type\"]\n    acq_card([\"Card: Fail\"])\n    acq_balance([\"Balance: Fail\"])\n    acq_bank([\"Bank: Fail\"])\n    acq_paynext([\"PayNext: Fail\"])\n  end\n\n  acq_fail --> acq_card\n  acq_fail --> acq_balance\n  acq_fail --> acq_bank\n  acq_fail --> acq_paynext\n  classDef svc    fill:#242930,stroke:#5794c7,stroke-width:2px,color:#fff\n  classDef ok     fill:#1c2c22,stroke:#47a468,stroke-width:2px,color:#fff\n  classDef fail   fill:#2c1e1e,stroke:#cc3333,stroke-width:2px,color:#fff\n  classDef client fill:#2c2020,stroke:#e05252,stroke-width:3px,color:#e05252,font-weight:bold\n  classDef net    fill:#2c251e,stroke:#ff8c42,stroke-width:2px,color:#fff",
