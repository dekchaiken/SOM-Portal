      "description": "Tail latency ของ Gateway สำหรับ CHARGE operation\n\nดูยังไง: P99 = 99% ของ request ใช้เวลาน้อยกว่าค่านี้ ถ้า P99 ขึ้นไปใกล้ 12s จะเริ่มมี session timeout ฝั่ง 7-11\n\nสำคัญ: avg อาจดูปกติแต่ P99 สูง = มีบาง request ที่ช้ามากทำให้ลูกค้า timeout",
      "fill": 1,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 503
      },
      "id": 9014,
      "lines": true,
      "linewidth": 1,
      "nullPointMode": "null",
      "stack": false,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "wFXCXqVSk"
          },
          "expr": "histogram_quantile(0.95, sum(rate(SEVEN_CUSTOM_IN_GATEWAY_processing_time_seconds_bucket{service=\"CHARGE\"}[5m])) by (le))",
          "legendFormat": "P95",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "wFXCXqVSk"
          },
          "expr": "histogram_quantile(0.99, sum(rate(SEVEN_CUSTOM_IN_GATEWAY_processing_time_seconds_bucket{service=\"CHARGE\"}[5m])) by (le))",
          "legendFormat": "P99",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "wFXCXqVSk"
          },
          "expr": "sum(rate(SEVEN_CUSTOM_IN_GATEWAY_processing_time_seconds_sum{service=\"CHARGE\"}[5m])) / sum(rate(SEVEN_CUSTOM_IN_GATEWAY_processing_time_seconds_count{service=\"CHARGE\"}[5m]))",
          "legendFormat": "avg",
          "refId": "C"
