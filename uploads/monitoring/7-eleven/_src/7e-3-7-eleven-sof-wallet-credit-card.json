    "content": "%%{init: {\"flowchart\": {\"useMaxWidth\": true, \"htmlLabels\": true}, \"theme\": \"dark\"}}%%\ngraph TD\n  ACQ[\"Acquiring Service\"] --> FR[\"Financial Router\"]\n  FR --> OMISE[\"Omise / OPN Gateway\"]\n\n  subgraph KTC_G[\"Gateway: KTC\"]\n    ktc_ok([\"OK\"])\n    ktc_fail([\"Fail\"])\n  end\n\n  subgraph BAY_G[\"Gateway: BAY (Krungsri Cybersource)\"]\n    bay_ok([\"OK\"])\n    bay_fail([\"Fail\"])\n  end\n\n  subgraph ALL_G[\"All Card — Total\"]\n    cc_ok([\"OK\"])\n    cc_fail([\"Fail\"])\n  end\n\n  OMISE --> KTC_G\n  OMISE --> BAY_G\n  OMISE --> ALL_G\n  classDef svc    fill:#242930,stroke:#5794c7,stroke-width:2px,color:#fff\n  classDef ok     fill:#1c2c22,stroke:#47a468,stroke-width:2px,color:#fff\n  classDef fail   fill:#2c1e1e,stroke:#cc3333,stroke-width:2px,color:#fff\n  classDef client fill:#2c2020,stroke:#e05252,stroke-width:3px,color:#e05252,font-weight:bold\n  classDef net    fill:#2c251e,stroke:#ff8c42,stroke-width:2px,color:#fff",
