    "content": "%%{init: {\"flowchart\": {\"useMaxWidth\": true, \"htmlLabels\": true}, \"theme\": \"dark\"}}%%\ngraph TD\n  ACQ[\"Acquiring Service\"] --> FS[\"Fund Service\"]\n  FS --> BG[\"Bank Gateway\"]\n\n  subgraph KBANK_G[\"KBANK\"]\n    kbank_ok([\"OK\"])\n    kbank_fail([\"Fail\"])\n  end\n  subgraph SCB_G[\"SCB\"]\n    scb_ok([\"OK\"])\n    scb_fail([\"Fail\"])\n  end\n  subgraph KTB_G[\"KTB\"]\n    ktb_ok([\"OK\"])\n    ktb_fail([\"Fail\"])\n  end\n  subgraph KKB_G[\"KKB\"]\n    kkb_ok([\"OK\"])\n    kkb_fail([\"Fail\"])\n  end\n  subgraph BAY_G[\"BAY\"]\n    bay_ok([\"OK\"])\n    bay_fail([\"Fail\"])\n  end\n  subgraph BBL_G[\"BBL\"]\n    bbl_ok([\"OK\"])\n    bbl_fail([\"Fail\"])\n  end\n\n  BG --> kbank_ok & kbank_fail\n  BG --> scb_ok & scb_fail\n  BG --> ktb_ok & ktb_fail\n  BG --> kkb_ok & kkb_fail\n  BG --> bay_ok & bay_fail\n  BG --> bbl_ok & bbl_fail\n  classDef svc    fill:#242930,stroke:#5794c7,stroke-width:2px,color:#fff\n  classDef ok     fill:#1c2c22,stroke:#47a468,stroke-width:2px,color:#fff\n  classDef fail   fill:#2c1e1e,stroke:#cc3333,stroke-width:2px,color:#fff\n  classDef client fill:#2c2020,stroke:#e05252,stroke-width:3px,color:#e05252,font-weight:bold\n  classDef net    fill:#2c251e,stroke:#ff8c42,stroke-width:2px,color:#fff",
