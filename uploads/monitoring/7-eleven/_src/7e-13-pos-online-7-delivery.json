        "content": "%%{init: {\"flowchart\": {\"useMaxWidth\": true, \"htmlLabels\": true}, \"theme\": \"dark\"}}%%\ngraph TD\n  subgraph APPS[\"7-Eleven Applications\"]\n    APP[\"7Delivery App\nPOS Online\"]\n  end\n\n  subgraph NETWORK[\"Network — AWS PrivateLink\"]\n    PRIV[\"PrivateLink (VPCE)\"]\n    NLB[\"NLB\"]\n  end\n\n  subgraph TMN[\"AWS — TrueMoney\"]\n    B2B[\"B2B In Gateway\"]\n    b2b_pay_ok([\"Pay: OK\"])\n    b2b_pay_fail([\"Pay: Fail\"])\n    b2b_ref_ok([\"Refund: OK\"])\n  end\n\n  APP --> PRIV\n  PRIV --> NLB\n  NLB --> B2B\n  B2B -->|200 OK| b2b_pay_ok\n  B2B -->|non-200| b2b_pay_fail\n  B2B --> b2b_ref_ok\n  classDef svc    fill:#242930,stroke:#5794c7,stroke-width:2px,color:#fff\n  classDef ok     fill:#1c2c22,stroke:#47a468,stroke-width:2px,color:#fff\n  classDef fail   fill:#2c1e1e,stroke:#cc3333,stroke-width:2px,color:#fff\n  classDef client fill:#2c2020,stroke:#e05252,stroke-width:3px,color:#e05252,font-weight:bold\n  classDef net    fill:#2c251e,stroke:#ff8c42,stroke-width:2px,color:#fff",
        "links": [],
