     },
     "expr": "sum(increase(B2B_IN_GATEWAY_transaction_total{service=\"payments-pay\",isv=\"010000000000292912477\",status_code!~\"200 OK|400 BAD_REQUEST\"}[5m]))",
     "instant": true,
