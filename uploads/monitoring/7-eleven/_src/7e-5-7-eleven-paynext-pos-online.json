    {
     "datasource": {
      "type": "prometheus",
      "uid": "wFXCXqVSk"
     },
     "expr": "sum(increase(B2B_IN_GATEWAY_transaction_total{service=\"payments-pay\",status_code=\"200 OK\",isv=\"010000000000292912477\"}[5m]))",
